{
  "private": true,
  "name": "@forumfortress/flarum",
  "version": "1.1.6",
  "devDependencies": {
    "@flarum/prettier-config": "^1.0.0",
    "flarum-tsconfig": "^2.0.0",
    "flarum-webpack-config": "^3.0.0",
    "flarum-webpack-config-v1": "npm:flarum-webpack-config@^2.0.2",
    "mithril": "^2.2.2",
    "prettier": "^2.5.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^4.9.1"
  },
  "scripts": {
    "build": "npm run build:v2 && npm run build:v1",
    "build:v1": "webpack --config webpack.v1.config.js --mode production",
    "build:v2": "webpack --config webpack.config.js --mode production",
    "dev": "webpack --mode development --watch",
    "dev:v1": "webpack --config webpack.v1.config.js --mode development --watch",
    "format": "prettier --write src"
  }
}
